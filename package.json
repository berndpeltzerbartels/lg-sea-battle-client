{
  "name": "lg-sea-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "game-server": "node server/dev-server.js",
    "test": "node --test \"server/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:temp": "node scripts/run-e2e-temp.mjs",
    "test:e2e:projectiles": "SEA_BATTLE_BASE_URL=${SEA_BATTLE_BASE_URL:-http://localhost:5174} playwright test tests/e2e/projectile-hit-accuracy.spec.js",
    "test:e2e:projectiles:temp": "node scripts/run-e2e-temp.mjs tests/e2e/projectile-hit-accuracy.spec.js",
    "test:e2e:projectiles:extended": "SEA_BATTLE_PROJECTILE_EXTENDED=1 SEA_BATTLE_BASE_URL=${SEA_BATTLE_BASE_URL:-http://localhost:5174} playwright test tests/e2e/projectile-hit-accuracy.spec.js",
    "test:e2e:projectiles:extended:temp": "SEA_BATTLE_PROJECTILE_EXTENDED=1 node scripts/run-e2e-temp.mjs tests/e2e/projectile-hit-accuracy.spec.js",
    "test:e2e:projectiles:headed": "SEA_BATTLE_BASE_URL=${SEA_BATTLE_BASE_URL:-http://localhost:5174} playwright test tests/e2e/projectile-hit-accuracy.spec.js --headed",
    "test:e2e:projectiles:report": "SEA_BATTLE_PROJECTILE_EXTENDED=1 SEA_BATTLE_BASE_URL=${SEA_BATTLE_BASE_URL:-http://localhost:5174} playwright test tests/e2e/projectile-hit-accuracy.spec.js --reporter=html",
    "test:e2e:show-report": "playwright show-report"
  },
  "dependencies": {
    "@babylonjs/core": "^8.13.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
